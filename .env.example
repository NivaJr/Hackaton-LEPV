# Copie para .env.local. Não comite valores reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente no servidor; não é necessária para as telas de demonstração.
SUPABASE_SECRET_KEY=

# IA somente no servidor. "disabled" (padrão) ou "gemini". Com gemini, LLM_API_KEY é obrigatória.
# Vazios usam gemini-2.5-flash e https://generativelanguage.googleapis.com/v1beta. PDF usa o dobro do tempo limite.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000

NEXT_PUBLIC_APP_URL=http://localhost:3000
