# Copie para .env.local. Não comite valores reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente no servidor; não é necessária para as telas de demonstração.
SUPABASE_SECRET_KEY=

# Política provisória explícita da equipe. Vazio impede iniciar novas atividades.
# LEPV_ORIGINAL_POINTS: valor positivo com no máximo duas casas decimais.
# LEPV_RECOVERY_REFERENCE: original ou previous.
# LEPV_ADAPTIVE_XP_FOLLOWS_ROOT: true ou false. O teto permanece ausente.
LEPV_ORIGINAL_POINTS=
LEPV_RECOVERY_REFERENCE=
LEPV_ADAPTIVE_XP_FOLLOWS_ROOT=

# O gateway inicial está desabilitado; a Tarefa 04 implementa o fornecedor.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000

NEXT_PUBLIC_APP_URL=http://localhost:3000
